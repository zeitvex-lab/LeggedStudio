    });
  } catch (e) { out.csvErr = String(e); }
  try { out.sample = await page.evaluate(() => window.__sim2simDebug ? window.__sim2simDebug.sample() : null); } catch (e) { out.sampleErr = String(e); }
  return JSON.stringify(out, null, 1);
})(page);
