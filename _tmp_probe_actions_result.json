await (async page => {
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.setCacheDisabled', { cacheDisabled: true });
  const rec = { steps: [] };
  await page.goto('http://127.0.0.1:8765/web/sim2sim/index.html?robot=unitree_go2&policy=go2-jump-69&debug=1', { waitUntil: 'domcontentloaded', timeout: 60000 });
  await page.waitForFunction(() => {
    const d = window.__sim2simDebug;
    if (!d || !d.sample) return false;
    const s = d.sample();
    return s.policyEnabled === true && s.baseZ !== null;
  }, null, { timeout: 120000 });
  rec.keys = await page.evaluate(() => {
    const st = window.__sim2simDebug.state();
    return { stateKeys: Object.keys(st).length, hasDefault: Array.isArray(st.defaultAngles), sampleKeys: Object.keys(window.__sim2simDebug.sample()) };
  });
  rec.first = await page.evaluate(() => ({ mode: window.__sim2simDebug.state().policyMode, inputs: window.__sim2simDebug.state().policyInputs }));
  for (let i = 0; i < 16; i += 1) {
    rec.steps.push(await page.evaluate(() => {
      const d = window.__sim2simDebug;
      const out = {};
      try {
        const s = d.fastForward(0.2);
        out.t = s && s.time;
        out.z = s && s.baseZ;
        out.qw = s && s.quat ? s.quat[0] : null;
        const st = d.state();
        const absMax = a => (Array.isArray(a) ? a.reduce((m, v) => Math.max(m, Math.abs(v)), 0) : null);
        out.actMax = absMax(st.action);
        out.appliedMax = absMax(st.appliedAction);
        out.obsMax = absMax(st.obs);
        out.obsNaN = Array.isArray(st.obs) ? st.obs.filter(v => !Number.isFinite(v)).length : null;
        out.tpos0 = Array.isArray(st.targetDofPos) ? st.targetDofPos[0] : null;
        out.default0 = Array.isArray(st.defaultAngles) ? st.defaultAngles[0] : null;
        out.policyEnabled = st.policyEnabled;
      } catch (e) { out.err = String(e).slice(0, 160); }
      return out;
    }));
  }
  return JSON.stringify(rec);
})(page);
