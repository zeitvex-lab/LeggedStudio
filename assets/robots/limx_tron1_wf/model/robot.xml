<mujoco model="limx_tron1_wf">
  <!-- LimX Dynamics TRON1 wheel-foot biped (WF_TRON1B, from the
       tron1-robot-description BSD-3 asset set). Package-local adaptation:
       - meshdir points at model/assets
       - no built-in actuators (PD / wheel velocity injected by the training
         task or the browser runtime)
       - tron1 default-class layout (visual / collision) matching limx_tron1_pf
       - euler orientations from the source MJCF converted to quats
       - imu sensors renamed to the mjlab velocity conventions
         (imu_ang_vel / imu_lin_vel / imu_lin_acc) + root_angmom -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <default>
    <default class="tron1">
      <joint armature="0.01" damping="0.01"/>
      <geom condim="3" friction="0.6 0.005 0.0001" margin="0.001" group="0" rgba="0 0 1 0"/>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="1" type="mesh" rgba="0.79216 0.81961 0.93333 1"/>
      </default>
      <default class="collision">
        <geom contype="1" conaffinity="1"/>
      </default>
      <site size="0.01" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <mesh name="base_Link" file="base_Link.STL"/>
    <mesh name="abad_L_Link" file="abad_L_Link.STL"/>
    <mesh name="hip_L_Link" file="hip_L_Link.STL"/>
    <mesh name="knee_L_Link" file="knee_L_Link.STL"/>
    <mesh name="wheel_L_Link" file="wheel_L_Link.STL"/>
    <mesh name="abad_R_Link" file="abad_R_Link.STL"/>
    <mesh name="hip_R_Link" file="hip_R_Link.STL"/>
    <mesh name="knee_R_Link" file="knee_R_Link.STL"/>
    <mesh name="wheel_R_Link" file="wheel_R_Link.STL"/>
  </asset>

  <worldbody>
    <body name="base_Link" pos="0 0 0.92" childclass="tron1">
      <inertial pos="0.0457123 0.000139854 -0.163809" quat="0.972578 -0.00615364 -0.232461 0.00398682" mass="9.595" diaginertia="0.154712 0.11093 0.0846371"/>
      <freejoint name="floating_base_joint"/>
      <site name="imu" pos="0 0 0"/>
      <geom class="visual" mesh="base_Link"/>
      <geom name="base_collision" class="collision" type="box" size="0.135 0.13 0.095" pos="0.03 0 -0.072" rgba="0 0 1 0.55"/>

      <body name="abad_L_Link" pos="0.05556 0.105 -0.2602">
        <inertial pos="-0.06977 0.04479 0.00057" quat="0.595024 0.579772 0.394141 0.393019" mass="1.469" diaginertia="0.00252289 0.00208104 0.00139163"/>
        <joint name="abad_L_Joint" axis="1 0 0" range="-0.38397 1.39626"/>
        <geom class="visual" mesh="abad_L_Link"/>
        <geom name="abad_L_collision" class="collision" type="cylinder" pos="-0.08 0 0" quat="0.707388269 0.706825181 0.000000000 0.000000000" size="0.05 0.025" rgba="0 0 1 0.55"/>

        <body name="hip_L_Link" pos="-0.077 0.0205 0">
          <inertial pos="-0.02869 -0.0477 -0.03992" quat="0.853885 0.192797 0.226903 0.426877" mass="2.3" diaginertia="0.0233264 0.0230229 0.00277548"/>
          <joint name="hip_L_Joint" axis="0 1 0" range="-1.01229 1.39626"/>
          <geom class="visual" rgba="1 1 1 1" mesh="hip_L_Link"/>
          <geom name="hip_L_collision" class="collision" type="cylinder" pos="-0.1 -0.025 -0.14" quat="0.965092501 0.000000000 0.261909268 0.000000000" size="0.035 0.075" rgba="0 0 1 0.55"/>

          <body name="knee_L_Link" pos="-0.15 -0.0205 -0.25981">
            <inertial pos="0.11913 0.01106 -0.20363" quat="0.687012 -0.159981 -0.201582 0.679548" mass="1.49" diaginertia="0.0177107 0.0171855 0.001015"/>
            <joint name="knee_L_Joint" axis="0 -1 0" range="-0.872665 1.36136"/>
            <geom class="visual" mesh="knee_L_Link"/>
            <geom name="knee_L_collision" class="collision" type="cylinder" pos="0.078 0 -0.12" quat="0.962425198 0.000000000 -0.271546937 0.000000000" size="0.015 0.13" rgba="0 0 1 0.55"/>

            <body name="wheel_L_Link" pos="0.15 0.0435 -0.25981">
              <inertial pos="3e-05 0.00807 -2e-05" quat="0.683013 0.183016 0.183017 0.683011" mass="1.08" diaginertia="0.00974272 0.00515568 0.00515344"/>
              <site name="foot_L" pos="0 0.008 0"/>
              <joint name="wheel_L_Joint" axis="0 1 0" range="-1000000 1000000" frictionloss="0.01"/>
              <geom class="visual" rgba="0.26667 0.26667 0.26667 1" mesh="wheel_L_Link"/>
