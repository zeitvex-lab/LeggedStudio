<mujoco model="deeprobotics_x30">
  <!-- Deeprobotics X30 quadruped. Package-local adaptation of the vendor
       mjcf (deep_robotics_model/X30, BSD assets):
       - meshdir points at model/assets; mirrored vendor meshes preserved
         (hip1/hip2/hip3, thigh1 carry the negative axis scales)
       - tron1-style default classes: visual (group 1) / collision primitives
       - collision primitives named for diagnostics; vendor values unchanged
       - LIDAR mounting bodies kept from the source model
       - imu site + mjlab-convention sensors added; no built-in actuators
         (PD injected by the training task / browser runtime) -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <default>
    <default class="x30">
      <geom condim="3" friction="0.6 0.005 0.0001" margin="0.001" group="0" rgba="0 0 1 0"/>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="1" type="mesh" rgba="0.79216 0.81961 0.93333 1"/>
      </default>
      <default class="collision">
        <geom contype="1" conaffinity="1" rgba="0 0 1 0.55"/>
      </default>
      <site size="0.01" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
