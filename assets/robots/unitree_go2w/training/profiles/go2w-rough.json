{
  "schema_version": "training-profile-1.0",
  "profile_id": "go2w-rough",
  "display_name": "Go2-W Velocity Rough",
  "source": "package-local velocity task",
  "source_root": "training/source",
  "entrypoints": {
    "env": "go2w_velocity:unitree_go2w_rough_env_cfg",
    "runner": "go2w_velocity:unitree_go2w_rough_ppo_runner_cfg",
    "runner_class": "mjlab.tasks.velocity.rl:VelocityOnPolicyRunner"
  },
  "backend": "native_mjlab",
  "task_name": "go2w_velocity_rough",
  "terrain_type": "rough",
  "algorithm": "PPO",
  "num_envs": 4096,
  "episode_length_s": 20.0,
  "command_ranges": {
    "lin_vel_x": [
      -1.0,
      1.0
    ],
    "lin_vel_y": [
      -0.5,
      0.5
    ],
    "ang_vel_z": [
      -1.0,
      1.0
    ]
  },
  "runner": {
    "hidden_dims": [
      512,
      256,
      128
    ],
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_param": 0.2,
    "entropy_coef": 0.005,
    "num_learning_epochs": 5,
    "num_mini_batches": 4,
    "num_steps_per_env": 24,
    "max_iterations": 10001,
    "save_interval": 1000
  },
  "sort_order": 20
}
