{
  "schema_version": "training-profile-1.0",
  "profile_id": "microduck-velocity-rough",
  "display_name": "Velocity / Rough",
  "source": "microduck_rl",
  "backend": "native_mjlab",
  "source_root": "training/source",
  "entrypoints": {
    "env": "mjlab_microduck.tasks.microduck_velocity_env_cfg:make_microduck_velocity_env_cfg",
    "runner": "mjlab_microduck.tasks:MicroduckRlCfg",
    "runner_class": "mjlab_microduck.tasks:MicroduckOnPolicyRunner"
  },
  "runner": {
    "max_iterations": 50000,
    "learning_rate": 0.001,
    "save_interval": 250,
    "num_steps_per_env": 24,
    "num_mini_batches": 4,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "entropy_coef": 0.01
  },
  "algorithm": "PPO",
  "task_name": "forward_walk",
  "terrain_type": "rough",
  "num_envs": 4096,
  "command_ranges": {
    "lin_vel_x": [
      -0.4,
      0.4
    ],
    "lin_vel_y": [
      -0.3,
      0.3
    ],
    "ang_vel_z": [
      -1.0,
      1.0
    ]
  },
  "sort_order": 100
}
