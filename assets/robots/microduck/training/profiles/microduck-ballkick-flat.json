{
  "schema_version": "training-profile-1.0",
  "profile_id": "microduck-ballkick-flat",
  "display_name": "BallKick / Flat",
  "source": "microduck_rl",
  "backend": "native_mjlab",
  "source_root": "training/source",
  "entrypoints": {
    "env": "mjlab_microduck.tasks.microduck_ball_kick_env_cfg:make_microduck_ball_kick_env_cfg",
    "runner": "mjlab_microduck.tasks:MicroduckBallKickRlCfg",
    "runner_class": "mjlab_microduck.tasks:MicroduckOnPolicyRunner"
  },
  "runner": {
    "max_iterations": 10000,
    "learning_rate": 0.001,
    "save_interval": 250,
    "num_steps_per_env": 24,
    "num_mini_batches": 4,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "entropy_coef": 0.01
  },
  "algorithm": "PPO",
  "task_name": "forward_walk",
  "episode_length_s": 5.0,
  "terrain_type": "plane",
  "num_envs": 4096,
  "command_ranges": {
    "lin_vel_x": [
      -0.01,
      0.01
    ],
    "lin_vel_y": [
      -0.01,
      0.01
    ],
    "ang_vel_z": [
      -0.05,
      0.05
    ]
  },
  "sort_order": 100
}
