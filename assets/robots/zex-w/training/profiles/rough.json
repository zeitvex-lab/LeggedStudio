{
  "schema_version": "training-profile-1.0",
  "profile_id": "zex-w-rough",
  "display_name": "ZEX-W Rough / obstacle curriculum",
  "source": "training/source/robot/config/env_cfgs.py::rough_env_cfg",
  "source_root": "training/source",
  "entrypoints": {"env": "robot.config.env_cfgs:rough_env_cfg", "runner": "robot.config.rl_cfg:rough_ppo_runner_cfg"},
  "backend": "native_mjlab",
  "terrain_type": "rough",
  "algorithm": "PPO",
  "num_envs": 2048,
  "episode_length_s": 20.0,
  "terrain": {"type": "generator", "curriculum": true, "sub_terrains": ["flat", "pyramid_stairs", "pyramid_stairs_inv", "random_grid", "random_rough", "perlin_noise", "rc_wall", "sloped_terrain"]},
  "curriculum": {"terrain_release": [[200, "random_grid"], [500, "pyramid_stairs_inv"], [700, "rc_wall"]], "adaptive_command_ranges": true},
  "command_ranges": {"lin_vel_x": [-1.0, 1.0], "lin_vel_y": [-1.0, 1.0], "ang_vel_z": [-1.0, 1.0]},
  "reward_terms": ["track_lin_vel", "track_ang_vel", "upright", "base_height_l2", "body_ang_vel", "is_terminated", "joint_torques", "joint_acc", "action_rate", "joint_pos_limits", "wheel_roll_tracking", "wheel_contact_bonus", "feet_air_time", "leg_motion_penalty", "stand_still", "body_collision"],
  "runner": {"hidden_dims": [512, 256, 128], "learning_rate": 0.0008, "entropy_coef": 0.003, "num_learning_epochs": 5, "num_mini_batches": 4, "num_steps_per_env": 24, "max_iterations": 20000}
}
