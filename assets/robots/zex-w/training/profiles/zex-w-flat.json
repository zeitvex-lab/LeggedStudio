{
  "schema_version": "training-profile-1.0",
  "profile_id": "zex-w-flat",
  "display_name": "ZEX-W Flat",
  "source": "training/source/robot/config/env_cfgs.py::flat_env_cfg",
  "source_root": "training/source",
