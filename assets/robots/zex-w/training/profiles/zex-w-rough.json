{
  "schema_version": "training-profile-1.0",
  "profile_id": "zex-w-rough",
  "display_name": "ZEX-W Rough / obstacle curriculum",
  "source": "training/source/robot/config/env_cfgs.py::rough_env_cfg",
  "source_root": "training/source",
  "entrypoints": {"env": "robot.config.env_cfgs:rough_env_cfg", "runner": "robot.config.rl_cfg:rough_ppo_runner_cfg"},
  "backend": "native_mjlab",
  "task_name": "rough_terrain",
  "terrain_type": "rough",
  "algorithm": "PPO",
  "num_envs": 2048,
  "episode_length_s": 20.0,
  "decimation": 4,
  "seed": 42,
  "action": {"leg_control": "position", "wheel_control": "velocity", "leg_scale": {"hip_abduction": 0.125, "hip_pitch": 0.25, "knee": 0.25}, "wheel_scale": 5.0, "stiffness": 50.0, "damping": 1.5, "wheel_damping": 1.0, "effort_limit": 17.0, "lowpass_cutoff_hz": {"legs": 5.0, "wheels": 15.0}, "delay_steps": [0, 2]},
  "command_ranges": {"lin_vel_x": [-1.0, 1.0], "lin_vel_y": [-1.0, 1.0], "ang_vel_z": [-1.0, 1.0]},
  "terrain": {"type": "generator", "curriculum": true, "tile_size": [8.0, 8.0], "num_rows": 10, "num_cols": 20, "max_init_terrain_level": 5, "sub_terrains": {"flat": 0.15, "pyramid_stairs": 0.05, "pyramid_stairs_inv": 0.35, "random_grid": 0.27, "random_rough": 0.01, "perlin_noise": 0.01, "rc_wall": 0.15, "sloped_terrain": 0.01}},
  "curriculum": {"terrain_levels": "terrain_levels_obstacle_release", "initial_terrains": ["flat", "random_rough", "perlin_noise", "sloped_terrain", "pyramid_stairs"], "terrain_release_env_steps": [[4800, ["random_grid"]], [12000, ["pyramid_stairs_inv"]], [16800, ["rc_wall"]]], "adaptive_command_ranges": true, "command_initial_range": [-0.5, 0.5], "command_delta": 0.05, "command_target_ratio": 0.8},
  "reward_terms": ["track_lin_vel_x_exp", "track_lin_vel_y_exp", "track_ang_vel_z_exp", "base_height_l2", "is_terminated", "joint_torques", "action_rate", "joint_pos_limits", "feet_air_time", "stair_lateral_yaw_drift", "lin_vel_z", "ang_vel_xy", "joint_power", "leg_joint_acc_l2", "wheel_joint_acc_l2", "joint_mirror", "stand_still", "joint_pos_penalty_ab", "joint_pos_penalty_sagittal", "abduction_mirror", "feet_contact_without_cmd", "upward", "undesired_contacts", "contact_forces"],
  "runner": {"hidden_dims": [512, 256, 128], "activation": "elu", "learning_rate": 0.0008, "entropy_coef": 0.003, "gamma": 0.99, "gae_lambda": 0.95, "clip_param": 0.2, "num_learning_epochs": 5, "num_mini_batches": 4, "num_steps_per_env": 24, "save_interval": 100, "max_iterations": 20000},
  "sort_order": 20
}
