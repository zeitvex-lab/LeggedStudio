{
  "schema_version": "training-profile-1.0",
  "profile_id": "go2-trot",
  "display_name": "Go2 Trot / Source Compatible",
  "source": "package-local task",
  "source_root": "training/source",
  "entrypoints": {
    "env": "local_tasks.robot_profiles:trot_env_cfg",
    "runner": "local_tasks.robot_profiles:trot_ppo_runner_cfg",
    "runner_class": "local_tasks.robots.unitree.go2.training.runner:VelocityOnPolicyRunner"
  },
  "backend": "native_mjlab",
  "task_name": "trot",
  "terrain_type": "plane",
  "algorithm": "PPO",
  "num_envs": 4096,
  "episode_length_s": 20.0,
  "history_length": 10,
  "command_ranges": {
    "lin_vel_x": [
      -1.0,
      1.0
    ],
    "lin_vel_y": [
      -1.0,
      1.0
    ],
    "ang_vel_z": [
      -1.0,
      1.0
    ]
  },
  "runner": {
    "hidden_dims": [
      512,
      256,
      128
    ],
    "learning_rate": 1e-05,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_param": 0.2,
    "entropy_coef": 0.01,
    "num_learning_epochs": 5,
    "num_mini_batches": 4,
    "num_steps_per_env": 24,
    "max_iterations": 15000,
    "save_interval": 100,
    "symmetry": "trot_jump_symmetry"
  },
  "sort_order": 30
}
