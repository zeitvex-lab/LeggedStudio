{
  "schema_version": "training-profile-1.0",
  "profile_id": "go2-spring-jump",
  "display_name": "Go2 Spring Jump",
  "source": "package-local task",
  "source_root": "training/source",
  "entrypoints": {
    "env": "local_tasks.robot_profiles:spring_jump_env_cfg",
    "runner": "local_tasks.robot_profiles:spring_jump_ppo_runner_cfg",
    "runner_class": "local_tasks.robots.unitree.go2.training.runner:VelocityOnPolicyRunner"
  },
  "backend": "native_mjlab",
  "task_name": "spring_jump",
  "terrain_type": "plane",
  "algorithm": "PPO",
  "num_envs": 4096,
  "episode_length_s": 5.0,
  "history_length": 10,
  "runner": {
    "hidden_dims": [
      512,
      256,
      128
    ],
    "learning_rate": 1e-05,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_param": 0.2,
    "entropy_coef": 0.01,
    "num_learning_epochs": 5,
    "num_mini_batches": 4,
    "num_steps_per_env": 24,
    "max_iterations": 50000,
    "save_interval": 100,
    "symmetry": "spring_jump_symmetry"
  },
  "sort_order": 50
}
