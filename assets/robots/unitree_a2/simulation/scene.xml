<mujoco model="unitree_a2_scene">
  <include file="../model/robot.xml"/>
  <compiler meshdir="model/assets"/>

  <option gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="100"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.7 0.8 0.9" rgb2="0.4 0.5 0.6" width="256" height="256"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.35 0.4 0.45" rgb2="0.4 0.45 0.5" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texrepeat="5 5"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
  </worldbody>
</mujoco>
