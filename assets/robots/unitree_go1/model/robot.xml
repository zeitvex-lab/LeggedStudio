        <joint name="FR_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.802851 0.802851" actuatorfrcrange="-23.7 23.7" armature="0.01" frictionloss="0.2"/>
        <geom name="FR_hip_visual" quat="0 1 0 0" type="mesh" contype="0" conaffinity="0" group="1" rgba="0.913725 0.913725 0.847059 1" mesh="hip"/>
        <geom name="FR_hip_collision" size="0.046 0.02" pos="0 -0.08 0" quat="0.707107 0.707107 0 0" type="cylinder" rgba="0 0 1 0.55"/>

        <body name="FR_thigh" pos="0 -0.08 0">
