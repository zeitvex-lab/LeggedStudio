      <freejoint name="floating_base_joint"/>
      <site name="imu" pos="0 0 0"/>
      <geom name="trunk_visual" type="mesh" contype="0" conaffinity="0" group="1" rgba="0.913725 0.913725 0.847059 1" mesh="trunk"/>
      <geom name="trunk_collision" size="0.1881 0.04675 0.057" type="box" rgba="0 0 1 0.55"/>

      <body name="depth_camera" pos="0.28 0 0.12" euler="0 0.43633 0">
        <camera name="depth_camera" pos="0 0 0" euler="1.57 -1.57 0" fovy="58"/>
        <geom name="depth_camera_visual" type="mesh" euler="-1.57 1.57 0" contype="0" conaffinity="0" group="1" rgba="0.913725 0.913725 0.847059 1" mesh="d435"/>
      </body>

      <body name="FR_hip" pos="0.1881 -0.04675 0">
