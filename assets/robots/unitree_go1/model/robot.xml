<mujoco model="unitree_go1">
  <!-- Unitree Go1 quadruped. Package-local adaptation of the
       LeggedSkillDeploy robot_description MJCF, with collisions completed
       against go1_description.urdf (authoritative):
       - trunk collision box restored to the URDF full size
         (half 0.1881 x 0.04675 x 0.057; the source MJCF used 0.13 in x)
       - hip collision uses the URDF cylinder (r 0.046, l 0.04, centred on
         the thigh joint axis); the source MJCF two-cylinder approximation
         and the stray visible cylinders in RR/RL were removed
       - thigh / calf keep the URDF boxes (0.213-long calf box, full length)
       - foot spheres r 0.02 kept
       - every collision geom is visible (rgba 0 0 1 0.55) per package style;
         the 1 mm inertial marker boxes of the source MJCF were dropped
       - imu site + mjlab-convention sensors; no built-in actuators
         (PD injected by the training task / browser runtime) -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <!-- timestep 不在此声明：运行时统一取 contract_v3.json control.physics_hz -->
  <option gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic" impratio="100" />

  <default>
    <joint axis="0 1 0" damping="0.1" armature="0.01" frictionloss="0.2"/>
  </default>

  <asset>
    <mesh name="trunk" file="trunk.stl"/>
    <mesh name="hip" file="hip.stl"/>
    <mesh name="thigh_mirror" file="thigh_mirror.stl"/>
    <mesh name="calf" file="calf.stl"/>
    <mesh name="thigh" file="thigh.stl"/>
    <mesh name="d435" file="d435_simplified.stl"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0.35">
