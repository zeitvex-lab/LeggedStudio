{
  "schema_version": "training-profile-1.0",
  "profile_id": "g1-velocity-flat",
  "display_name": "G1 Velocity Flat",
  "source": "package-local velocity task",
  "source_root": "training/source",
  "entrypoints": {
    "env": "g1_velocity:g1_flat_env_cfg",
    "runner": "g1_velocity:g1_runner_cfg",
    "runner_class": "mjlab.tasks.velocity.rl:VelocityOnPolicyRunner"
  },
  "backend": "native_mjlab",
  "task_name": "velocity",
  "terrain_type": "flat",
  "algorithm": "PPO",
  "num_envs": 4096,
  "episode_length_s": 20.0,
  "runner": {
    "hidden_dims": [512, 256, 128],
    "learning_rate": 0.001,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_param": 0.2,
    "entropy_coef": 0.01,
    "num_learning_epochs": 5,
    "num_mini_batches": 4,
    "num_steps_per_env": 24,
    "max_iterations": 5000,
    "save_interval": 100
  },
  "sort_order": 30
}
