<mujoco model="wuji_reorient_cube">
  <!-- 54 mm / 120 g in-hand cube for the Wuji Hand reorientation task.
       Source: 00_resources/wuji-mjlab .../objects/inhand_object/xmls/cube.xml.
       The published bundle omits the ArUco-textured mesh + textures, so the
       visible geometry is a plain box; the collision box, mass, friction and
       contact priority match the source exactly.

       Contact priority: hand geoms use priority=1, cube uses priority=0, so
       the hand's solref/solimp govern the grasp contact. -->
  <default>
    <default class="cube">
      <geom friction=".3" conaffinity="2" condim="3" priority="0"
            solref="0.015 1.0" solimp="0.85 0.85 0.001"/>
    </default>
  </default>

  <asset>
    <material name="cube" rgba="0.85 0.72 0.35 1"/>
    <material name="cube_gray" rgba="0.55 0.57 0.60 1"/>
  </asset>

  <worldbody>
    <body name="cube" pos="-0.0967 0.0100 0.5599" quat="1 0 0 0" childclass="cube">
      <freejoint name="cube_freejoint"/>
      <geom name="cube" type="box" size=".027 .027 .027" mass=".120" material="cube" group="3"/>
      <site name="cube_center" pos="0 0 0" group="4"/>
    </body>
  </worldbody>
</mujoco>
