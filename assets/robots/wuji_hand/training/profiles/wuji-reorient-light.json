{
  "schema_version": "training-profile-1.0",
  "profile_id": "wuji-reorient-light",
  "display_name": "Wuji Reorient Light",
  "source": "package-local reorient task",
  "source_root": "training/source",
  "entrypoints": {
    "env": "wuji_tasks.tasks.reorient.config.wuji_hand.env_cfgs:wuji_hand_reorient_env_cfg",
    "runner": "wuji_tasks.tasks.reorient.config.wuji_hand.rsl_rl.ppo:wuji_hand_reorient_ppo_runner_cfg",
    "runner_class": "wuji_tasks.rl.runner:WujiOnPolicyRunner"
  },
  "backend": "native_mjlab",
  "task_name": "reorient",
  "terrain_type": "plane",
  "algorithm": "PPO",
  "num_envs": 4096,
  "episode_length_s": 50.0,
  "runner": {
    "hidden_dims": [
      512,
      256,
      128
    ],
    "learning_rate": 0.0001,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_param": 0.2,
    "entropy_coef": 0.001,
    "num_learning_epochs": 5,
    "num_mini_batches": 32,
    "num_steps_per_env": 24,
    "save_interval": 100,
    "max_iterations": 7500
  },
  "sort_order": 20,
  "notes": "轻量版：4096 envs x 7500 iters。"
}
