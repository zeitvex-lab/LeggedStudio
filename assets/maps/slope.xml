<?xml version="1.0" encoding="utf-8"?>
<mujoco model="map_slope">
  <compiler meshdir="../model/assets" />

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" />

  <statistic center="6 0 0.4" extent="1.2" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="135" elevation="-25" />
    <quality shadowsize="4096" />
  </visual>
<asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
<material name="terrain" rgba="0.55 0.58 0.62 1" reflectance="0.05" />
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true" castshadow="true" />
<geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="0.8 0.05 0.01" />

    <!-- 15° 上下坡走廊（布局取自 rc_old/zex-w 的走廊尺度，但坡道几何用**薄板倾斜**：
         zex-w 原版用 size_z=1.5327 的厚板旋转，实测会露出一块悬空斜板并遮住顶台
         （射线剖面在 x≈2.0 处出现 61°~78° 的"墙"），不可通行，故不照搬其做法）。
         坡面节点：前平台 z=0.010 → 上坡 +15° → 顶台 z=0.814 → 下坡 −15° → 后平台 z=0.010
         坡道中心 z 的算法：pos_z = 坡面中点 z − size_z·cos(15°)            -->
    <geom name="start_pad" type="box" pos="1.7500 0 0.0050" size="0.7500 1.5 0.0050" material="terrain" />
    <geom name="ramp_up" type="box" pos="4.0000 0 0.3637" size="1.5529 1.5 0.05" quat="0.991445 0 -0.130526 0" material="terrain" />
    <geom name="top_platform" type="box" pos="6.5000 0 0.7640" size="1.0000 1.5 0.05" material="terrain" />
    <geom name="ramp_down" type="box" pos="9.0000 0 0.3637" size="1.5529 1.5 0.05" quat="0.991445 0 0.130526 0" material="terrain" />
    <geom name="end_pad" type="box" pos="11.2500 0 0.0050" size="0.7500 1.5 0.0050" material="terrain" />
  </worldbody>
</mujoco>
