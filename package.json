{
  "name": "legged-studio",
  "version": "0.43.0",
  "description": "Legged Robot RL Studio - Desktop Launcher",
  "main": "electron/launcher/main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "dev": "node scripts/start-electron.js --dev",
    "build": "electron-builder",
    "release:check": "node scripts/release-check.js",
    "build:portable": "npm run release:check && electron-builder --win portable",
    "build:online:win": "npm run release:check && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_windows_online.ps1",
    "verify:online:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_online.ps1",
    "stage:runtime:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage_windows_runtime.ps1",
    "build:portable:embedded": "npm run release:check && npm run stage:runtime:win && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_windows_embedded.ps1",
    "verify:embedded:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_embedded.ps1",
    "build:win": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage",
    "build:dir": "electron-builder --dir",
    "test": "uv run --no-sync python -m unittest discover -s backend -p \"test_*.py\" -v",
    "test:obs": "node web/sim2sim/obs/observation_builders.test.mjs"
  },
  "keywords": [
    "robotics",
    "reinforcement-learning",
    "legged-robot"
  ],
  "author": "zeitvex",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.leggedstudio.app",
    "productName": "Legged Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/launcher/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "app/backend"
      },
      {
        "from": "contracts",
        "to": "app/contracts"
      },
      {
        "from": "assets/robots",
        "to": "app/assets/robots",
        "filter": [
          "!**/__pycache__{,/**/*}"
        ]
      },
      {
        "from": "web",
        "to": "app/web"
      },
      {
        "from": "adapters",
        "to": "app/adapters",
        "filter": [
          "!**/.venv{,/**/*}",
          "!**/__pycache__{,/**/*}",
          "!**/*.pyc"
        ]
      },
      {
        "from": "tools",
        "to": "app/tools"
      },
      {
        "from": "scripts",
        "to": "app/scripts",
        "filter": [
          "!**/__pycache__{,/**/*}",
          "!**/*.pyc"
        ]
      },
      {
        "from": "VERSION",
        "to": "app/VERSION"
      },
      {
        "from": "QUADRUPED_ASSET_INVENTORY.json",
        "to": "app/QUADRUPED_ASSET_INVENTORY.json"
      }
    ],
    "win": {
      "target": "portable",
      "executableName": "Legged Studio",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Development"
    }
  }
}
