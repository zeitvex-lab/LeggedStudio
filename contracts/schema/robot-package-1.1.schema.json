{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legged-studio/robot-package-1.1",
  "title": "Robot Package v1.1",
  "description": "机器人包 manifest（T0.1 兄弟 schema 之一）。相对 robot-package-1.0 的升级为纯加法：新增 version/license/integrity/runtime_requirements 可选字段，全部旧字段语义不变（T6.1 插件协议在此文件上演进为 ls_plugin manifest）。",
  "type": "object",
  "required": ["schema_version", "package_id", "model", "contract_path", "simulation_config_path"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "enum": ["robot-package-1.0", "robot-package-1.1"],
      "description": "1.1 = 声明本 schema 的可选扩展字段"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "如 generic_mjlab / mjlab_source_profiles / package_extension / mujoco_sim"
    },
    "model": {
      "type": "object",
      "required": ["format", "path"],
      "properties": {
        "format": {
          "enum": ["mjcf", "urdf"]
        },
        "path": {
          "type": "string"
        },
        "assets_path": {
          "type": "string"
        }
      }
    },
    "contract_path": {
      "type": "string"
    },
    "contract_v3_path": {
      "type": "string",
      "description": "1.1 新增：契约 v3 sidecar 相对路径（T0.2 迁移产物，如 'contract_v3.json'）"
    },
    "simulation_config_path": {
      "type": "string"
    },
    "training_config_path": {
      "type": "string"
    },
    "training_source_path": {
      "type": "string"
    },
    "extension_entrypoint": {
      "type": "string"
    },
    "extension_root": {
      "type": "string"
    },
    "source_project": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "1.1 新增：包语义版本"
    },
    "license": {
      "type": "object",
      "description": "1.1 新增：许可链。spdx/source 是**我们自己的打包许可**（非上游资产许可）；components 是上游资产逐条出处（随资源走）；redistribution 为 allowed / restricted-noncommercial / unknown（**取不到证据时是 unknown，绝不默认 allowed**）",
      "properties": {
        "spdx": {
          "type": ["string", "null"],
          "description": "打包许可的 SPDX id（来自 package.json#license，非上游资产许可）"
        },
        "source": {
          "type": ["string", "null"],
          "description": "上述 spdx 的出处（如 package.json#license）"
        },
        "redistribution": {
          "enum": ["allowed", "restricted-noncommercial", "unknown"],
          "description": "再分发口径：含非商用上游（CC-BY-NC 等）即 restricted-noncommercial；取证不全即 unknown"
        },
        "components": {
          "type": "array",
          "description": "上游资产逐条许可依据（与 registry/licenses.json 对账）",
          "items": {
            "type": "object",
            "properties": {
              "root": { "type": ["string", "null"] },
              "path": { "type": ["string", "null"] },
              "sha256": { "type": ["string", "null"] },
              "spdx": { "type": ["string", "null"] }
            }
          }
        },
        "unresolved": {
          "type": "array",
          "description": "未取证的缺口（清单自己披露未证之处）",
          "items": {
            "type": "object",
            "properties": {
              "upstream": { "type": ["string", "null"] },
              "reason": { "type": ["string", "null"] },
              "leads": { "type": "array" }
            }
          }
        }
      },
      "required": ["spdx", "source", "redistribution"]
    },
    "integrity": {
      "type": "object",
      "description": "1.1 新增：{model_sha256, contract_sha256, assets_manifest}（T6.3 分发 hash 门消费）"
    },
    "runtime_requirements": {
      "type": "object",
      "description": "1.1 新增：{python, mjlab, mujoco} 版本约束"
    }
  }
}
