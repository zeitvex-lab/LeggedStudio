<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:macro name="ultraSound" params="name *origin">

		<joint name="ultraSound_joint_${name}" type="fixed">
			<xacro:insert_block name="origin"/>
			<parent link="trunk"/>
			<child link="ultraSound_${name}"/>
		</joint>

		<link name="ultraSound_${name}">
			<visual>
				<geometry>
					<mesh filename="file://$(find unitree_go1_description)/meshes/ultraSound.dae"/>
				</geometry>
			</visual>
		</link>
	</xacro:macro>
</robot>