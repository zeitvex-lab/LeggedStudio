<?xml version="1.0"?>
<!--
  Rigid preview of microduck_combined.stl.

  assemble.py produced the STL by evaluating robot_allcollisions.xml at zero
  joint angles, applying every body and visual-geom transform, and concatenating
  the transformed meshes. The resulting vertices are already expressed in the
  source model's world frame, so this MJCF must not apply those transforms again.

  Use robot_allcollisions.xml for articulated dynamics. This single, non-convex
  mesh is visual-only: treating its convex hull as collision geometry would fill
  the space between the legs and produce incorrect contacts.
-->
<mujoco model="microduck_combined_preview">
  <compiler angle="radian" meshdir="."/>
  <option timestep="0.005" gravity="0 0 0"/>

  <statistic center="0.0203 0 0.1455" extent="0.19"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.65 0.65 0.65" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-18"/>
  </visual>

  <asset>
    <mesh name="microduck_combined_mesh" file="microduck_combined.stl"/>
    <material name="microduck_material" rgba="0.92 0.74 0.16 1" specular="0.15" shininess="0.25"/>
  </asset>

  <worldbody>
    <light name="key" pos="-1 -1 2" dir="0.4 0.4 -1" directional="true"/>
    <body name="microduck_combined" pos="0 0 0">
      <freejoint name="root"/>
      <!-- Aggregate of all source-body inertias at the baked zero-angle pose. -->
      <inertial
        pos="0.00173557127514 -0.0000136372855729 0.1462030165"
        mass="0.73724318"
        fullinertia="0.00485412719217 0.00502336918607 0.00168437938651 -0.00000716036331783 -0.00140710329973 0.000000591812653782"/>
      <geom
        name="visual"
        type="mesh"
        mesh="microduck_combined_mesh"
        material="microduck_material"
        group="2"
        contype="0"
        conaffinity="0"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="baked_pose" qpos="0 0 0 1 0 0 0"/>
  </keyframe>
</mujoco>
