# request

# 请求数据头
std_msgs/Header header

# 可选项，音量类型，默认本体扬声器
VolumeType type

---

# ----------------------------------------------------
# response

# 响应数据头
std_msgs/Header header

# 当前音量（0~100）
uint32 audio_volume