diff --git a/rosidl_typesupport_c/bin/rosidl_typesupport_c b/rosidl_typesupport_c/bin/rosidl_typesupport_c
index 7b6f80e..547547c 100644
--- a/rosidl_typesupport_c/bin/rosidl_typesupport_c
+++ b/rosidl_typesupport_c/bin/rosidl_typesupport_c
@@ -7,6 +7,7 @@ from rosidl_typesupport_c import generate_c
 
 
 def main(argv=sys.argv[1:]):
+    print("argv", argv)
     parser = argparse.ArgumentParser(
         description='Generate the C type support to handle ROS messages.',
         formatter_class=argparse.ArgumentDefaultsHelpFormatter)
@@ -17,9 +18,10 @@ def main(argv=sys.argv[1:]):
     parser.add_argument(
         '--typesupports',
         required=True,
-        nargs='+',
+        action='append',
         help='The typesupports to be used')
     args = parser.parse_args(argv)
+    print("args", args)
 
     generate_c(args.generator_arguments_file, args.typesupports)
 
