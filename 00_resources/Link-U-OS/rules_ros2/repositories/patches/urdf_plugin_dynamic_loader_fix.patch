+#ifndef URDF_PLUGIN_H
+#define URDF_PLUGIN_H
+
+#include <urdf_parser_plugin/parser.h>
+#include <string>
+#include <memory>
+
+namespace urdf
+{
+
+/**
+ * @brief URDF XML解析器插件类
+ * 
+ * 该类实现了URDFParser接口，用于解析XML格式的URDF机器人描述文件
+ */
+class URDFXMLParser final : public urdf::URDFParser
+{
+public:
+  URDFXMLParser() = default;
+  ~URDFXMLParser() = default;
+
+  /**
+   * @brief 解析XML字符串为URDF模型
+   * 
+   * @param xml_string 包含URDF描述的XML字符串
+   * @return urdf::ModelInterfaceSharedPtr 解析后的模型指针
+   */
+  urdf::ModelInterfaceSharedPtr parse(const std::string & xml_string) override;
+
+  /**
+   * @brief 检查数据是否可能是URDF XML格式
+   * 
+   * @param data 要检查的数据字符串
+   * @return size_t 如果可能是URDF XML，返回"<robot"在字符串中的位置；
+   *                如果确定是XML但不是URDF，返回字符串长度
+   */
+  size_t might_handle(const std::string & data) override;
+};
+
+/**
+ * @brief 创建URDF XML解析器的工厂函数
+ * 
+ * @return std::shared_ptr<URDFParser> 创建的解析器实例
+ */
+std::shared_ptr<URDFParser> createURDFXMLParser();
+
+}  // namespace urdf
+
+#endif  // URDF_PLUGIN_H
