""" Builds rmw_fastrtps.
"""

load("@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl", "ros2_cpp_binary")

ros2_cpp_binary(
    name = "rmw_fastrtps",
    srcs = glob([
        "rmw_fastrtps_cpp/**/*.cpp",
        "rmw_fastrtps_cpp/**/*.hpp",
        "rmw_fastrtps_cpp/**/*.h",
        "rmw_fastrtps_shared_cpp/**/*.hpp",
        "rmw_fastrtps_shared_cpp/**/*.h",
        "rmw_fastrtps_shared_cpp/**/*.cpp",
        
    ], exclude = ["**/*test*.cpp"]),
    copts = ["-fvisibility=hidden"],
    linkopts = ["-fvisibility=hidden"],
    linkshared = True,
    visibility = ["//visibility:public"],
    deps = [
        "@integration//:fastcdr",
        "@integration//:fastrtps",
        "@ros2_rcpputils//:rcpputils",
        "@ros2_rcutils//:rcutils",
        "@ros2_rmw//:rmw",
        "@ros2_rmw//:rmw_cpp",
        "@ros2_rmw_dds_common//:rmw_dds_common_lib",
        "@ros2_rosidl//:rosidl_runtime_c",
        "@ros2_tracing//:tracetools",
        "@ros2_rosidl//:rosidl_typesupport_introspection_c",
        "@ros2_rosidl//:rosidl_typesupport_introspection_cpp",
        "@ros2_rosidl_typesupport_fastrtps//:rosidl_typesupport_fastrtps_cpp",
    ],
    includes = ["rmw_fastrtps_cpp/include", "rmw_fastrtps_shared_cpp/include"],
)
