      "variants": {
        "base": {
          "algorithm": "adapters.mjlab.algorithms.cts.algorithms:CtsPPO",
          "actor": "adapters.mjlab.algorithms.cts.models:CtsActorModel",
          "critic": "adapters.mjlab.algorithms.cts.models:CtsCriticModel"
        },
        "amp": {
          "algorithm": "adapters.mjlab.algorithms.cts.algorithms:AmpCtsPPO",
